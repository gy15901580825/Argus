# Database Configuration
DATABASE_URL=postgresql://user:password@postgres-service:5432/argus

# Microsoft Entra External ID (CIAM) Authentication
CIAM_TENANT_NAME=your_ciam_tenant_subdomain
CIAM_TENANT_ID=your_ciam_tenant_id
CIAM_BACKEND_CLIENT_ID=your_ciam_backend_client_id
CIAM_BACKEND_CLIENT_SECRET=your_ciam_backend_client_secret

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudflare R2 Storage Configuration
# Get these from Cloudflare R2 dashboard: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=argus-scripts
# Optional: Custom domain for R2 bucket (if configured)
# R2_PUBLIC_URL_BASE=https://scripts.yourdomain.com

# Application Configuration
LOG_LEVEL=INFO
