<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Argus Red-Team Report — Run {{ run.id[:8] }}</title>
<style>
body { font-family: -apple-system, system-ui, sans-serif; margin: 2em; max-width: 1200px; }
h1 { border-bottom: 2px solid #333; }
.summary { display: flex; gap: 2em; margin: 1em 0; }
.metric { padding: 1em; border: 1px solid #ddd; border-radius: 4px; min-width: 120px; }
.metric .v { font-size: 2em; font-weight: bold; }
.fail { color: #c00; }
.warn { color: #c80; }
.pass { color: #080; }
.severity-critical, .severity-high { font-weight: bold; color: #c00; }
.severity-medium { color: #c80; }
.severity-low, .severity-info { color: #888; }
.target { color: #555; margin-top: -0.6em; }
.finding { border: 1px solid #ddd; border-radius: 4px; padding: 1em; margin: 1em 0; }
.finding pre { background: #f4f4f4; padding: 0.5em; overflow-x: auto; max-width: 100%; white-space: pre-wrap; }
.evidence { border-left: 3px solid #7a5; background: #f6faf4; padding: 0.6em 0.9em; margin: 0.8em 0; }
.evidence table { border-collapse: collapse; margin: 0.4em 0; font-size: 0.92em; }
.evidence th, .evidence td { border: 1px solid #cfd8cc; padding: 0.25em 0.6em; text-align: left; }
.evidence .num { font-variant-numeric: tabular-nums; text-align: right; }
.evidence .note { font-size: 0.85em; color: #555; margin: 0.4em 0 0; }
.deterministic { font-size: 0.8em; color: #567; border: 1px solid #ccd; padding: 0 0.35em; }
.mappings { margin: 0.5em 0; font-size: 0.9em; color: #666; }
.mappings code { background: #eef; padding: 0.1em 0.4em; border-radius: 3px; margin-right: 0.4em; }
.coverage-caveat { font-style: italic; color: #555; }
.coverage-table { border-collapse: collapse; margin: 0.5em 0 1.5em; font-size: 0.92em; }
.coverage-table th, .coverage-table td { border: 1px solid #ccc; padding: 0.25em 0.6em; text-align: left; }
.coverage-table td.library-thin { background: #ffe8b0; }
.coverage-table td.library-absent { background: #fdd; }
</style>
</head>
<body>
<h1>Argus Red-Team Report</h1>
<p>Run ID: <code>{{ run.id }}</code> · Status: <strong>{{ run.status }}</strong> · Probes: {{ run.findings | length }}</p>
{% if run.status == "incomplete" %}<p class="incomplete" style="background:#fff3cd;border:1px solid #e0c060;padding:0.5em 0.8em"><strong>This run is incomplete.</strong> Some probes produced no verdict or the run stopped early, so a clean result here is not a clean bill of health. See Notes below.</p>
{% endif %}{% if run.target_spec %}
<p class="target">Target: <code>{{ run.target_spec.kind }}</code>{% if run.target_spec.label %} — {{ run.target_spec.label }}{% endif %}{% if run.probe_suite %} · Suite: <code>{{ run.probe_suite }}</code>{% endif %}</p>
{% endif %}
<div class="summary">
  <div class="metric"><div class="v fail">{{ counts.fail }} fail</div></div>
  <div class="metric"><div class="v warn">{{ counts.warn }} warn</div></div>
  <div class="metric"><div class="v pass">{{ counts.pass }} pass</div></div>
  <div class="metric"><div class="v">{{ counts.escalated }} escalated</div></div>
</div>
<h2>Findings ({{ run.findings | length }})</h2>
{% for f in run.findings %}
<div class="finding">
  <h3>{{ f.probe_id }} — <span class="{{ f.verdict }}">{{ f.verdict }}</span> · <span class="severity-{{ f.severity }}">{{ f.severity }}</span> · confidence {{ "%.2f"|format(f.confidence) }}</h3>
  <p><strong>Attack prompt:</strong></p>
  <pre>{{ f.attack_prompt }}</pre>
  <p><strong>Target response:</strong></p>
  <pre>{{ f.target_response | truncate(800) }}</pre>
  {% if f.judge_model %}
  <p><strong>Judge reasoning:</strong> {{ f.reasoning }}</p>
  {% else %}
  <p><strong>Verdict basis:</strong> {{ f.reasoning }} <span class="deterministic">deterministic — no model consulted</span></p>
  {% endif %}
  {% if f.evidence %}
  <div class="evidence">
    <p><strong>Evidence — what the target actually did</strong></p>
    {#- Evidence is per-family. Keyed on the shape actually present, never on
        "not payment, therefore payment prose": an MCP finding used to render
        "No payment authorization was presented" over a tool call it never
        showed. -#}
    {% if 'rounds' in f.evidence and 'scope_note' in f.evidence %}
    {#- mcp-trap: one finding folds several rounds; show each round, not a single testbed summary. -#}
    {% set s = f.evidence.summary %}
    <p>{{ s.failed }}/{{ s.conclusive }} rounds failed{% if s.inconclusive %} ({{ s.inconclusive }} inconclusive){% endif %}.</p>
    <table>
      <tr><th>Round</th><th>Outcome</th><th>Reason</th><th>Tool calls (arguments shortened)</th><th>Canary seen</th></tr>
      {% for r in f.evidence.rounds %}
      <tr>
        <td class="num">{{ r.round }}</td>
        <td>{{ r.outcome }}</td>
        <td>{{ r.reason }}</td>
        <td>{% for c in r.evidence.tool_calls or [] %}{% if c is string %}{{ c }}{% else %}<code>{{ c.tool }}</code> <code>{{ c.arguments | tojson }}</code>{% if r.evidence.rug_pull %} (definition in force: {{ c.definition_in_force }}; agent last listed: {{ c.agent_last_listed or "never" }}){% endif %}{% endif %}{% if not loop.last %}<br>{% endif %}{% else %}none{% endfor %}</td>
        <td>{{ "yes" if r.evidence.canary_hits else "no" }}</td>
      </tr>
      {% endfor %}
    </table>
    {% set notes = f.evidence.rounds | map(attribute='notes') | sum(start=[]) | unique | list %}
    {% if notes %}
    <p class="note">Notes: {{ notes | join('; ') }}.</p>
    {% endif %}
    <p class="note">{{ f.evidence.scope_note }}{% if f.evidence.conversations_sent %} {{ f.evidence.conversations_sent }} conversations were sent to the agent in this run.{% endif %}</p>
    {% elif 'tool_calls' in f.evidence %}
    {% if f.evidence.tool_calls %}
    <table>
      <tr><th>#</th><th>Tool called</th><th>Arguments</th><th>After description change</th></tr>
      {% for c in f.evidence.tool_calls %}
      <tr>
        <td class="num">{{ c.seq }}</td>
        <td><code>{{ c.tool }}</code></td>
        <td><code>{{ c.arguments | tojson }}</code></td>
        <td>{{ "yes" if c.after_description_change else "no" }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p>The agent called no MCP tool.</p>
    {% endif %}
    {% if f.evidence.shadow_tool_names %}
    <p class="note">Tool name(s) the hostile server shadowed or planted: {% for n in f.evidence.shadow_tool_names %}<code>{{ n }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {% endif %}
    {% elif 'authorizations' in f.evidence %}
    {% if f.evidence.authorizations %}
    <table>
      <tr><th>Amount</th><th>Asset</th><th>Paid to</th><th>Settled</th></tr>
      {% for a in f.evidence.authorizations %}
      <tr>
        <td class="num">{{ a.amount }}</td>
        <td>{{ a.asset }}</td>
        <td><code>{{ a.payee }}</code></td>
        <td>{{ "yes" if a.settled else "no" }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p>No payment authorization was presented.</p>
    {% endif %}
    {% elif 'items' in f.evidence %}
    <ul>
      {% for item in f.evidence['items'] %}
      <li><code>{{ item if item is string else item | tojson }}</code></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if 'items' not in f.evidence and not ('rounds' in f.evidence and 'scope_note' in f.evidence) %}
    <p class="note">
      {{ f.evidence.interaction_count }} request(s) to the testbed{% if 'tools_list_count' in f.evidence %}, {{ f.evidence.tools_list_count }} tool listing(s) served{% endif %}.
      {% if f.evidence.expected_payee %}Session payee: <code>{{ f.evidence.expected_payee }}</code>.{% endif %}
      {% if 'authorizations' in f.evidence %}All payments are simulated against a mock facilitator; no real transfer occurred.{% endif %}
    </p>
    {% endif %}
  </div>
  {% endif %}
  <div class="mappings">
    {% for a in f.atlas_id %}<code>ATLAS:{{ a }}</code>{% endfor %}
    {% for o in f.owasp_id %}<code>OWASP:{{ o }}</code>{% endfor %}
    {% for n in f.nist_id %}<code>NIST:{{ n }}</code>{% endfor %}
    {% for e in f.eu_ai_act_id %}<code>EU:{{ e }}</code>{% endfor %}
  </div>
  <p style="font-size:0.85em;color:#888">{% if f.judge_model %}judge: {{ f.judge_model }}{% if f.escalated_model %} → {{ f.escalated_model }}{% endif %}{% else %}verdict: deterministic, from captured evidence{% endif %} · target latency: {{ "%.0f"|format(f.target_latency_ms) }}ms · probed at {{ f.probed_at }}</p>
</div>
{% endfor %}
{% if run.notes %}
<h2>Notes</h2>
<ul class="notes">
  {% for n in run.notes %}<li>{{ n }}</li>
  {% endfor %}
</ul>
{% endif %}
{% if coverage %}
<h2>Coverage</h2>
<p>What this run did <strong>not</strong> test matters as much as what it found. Counts below are raw —
no percentages, no scores. Cells with {{ coverage.thin_threshold }} or fewer probes in the library are marked <code>thin</code>;
cells with none are marked <code>absent</code>.</p>
{% for std_key, std in coverage.standards.items() %}
<h3>{{ std_key }}</h3>
{% if std.universe == "open" %}
<p class="coverage-caveat">Open-ended standard: this table lists only the cells this probe library's mappings touch — it is not a measurement of coverage against the full standard.</p>
{% endif %}
<table class="coverage-table">
  <tr><th>ID</th><th>Name</th><th>Library status</th><th>Run status</th><th>Probes in library</th><th>Probes run</th><th>Verdicts</th></tr>
  {% for cell in std.cells %}
  <tr>
    <td>{{ cell.id }}</td>
    <td>{{ cell.name if cell.name is defined else "—" }}</td>
    <td class="library-{{ cell.library_status }}">{{ cell.library_status }}</td>
    <td>{{ cell.run_status }}</td>
    <td>{{ cell.probes_in_library }}</td>
    <td>{{ cell.probes_run }}</td>
    <td>{% for verdict, n in cell.verdicts.items() %}{{ verdict }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
  </tr>
  {% endfor %}
  {% if not std.cells %}
  <tr><td colspan="7">no cells touched by this run's library</td></tr>
  {% endif %}
</table>
{% endfor %}
{% endif %}
</body>
</html>
