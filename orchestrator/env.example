GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=""
GEMINI_MODEL_NAME="gemini-3-pro-preview"
OPENAI_API_KEY=""
GPT_MODEL_NAME="gpt-5.4-mini"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL_NAME="anthropic/claude-opus-4-7"

# Planner configuration (defaults shown)
PLANNER_MODEL_PROVIDER="anthropic"
PLANNER_MODEL="claude-opus-4-7"
PLANNER_FALLBACK_MODEL="gpt-5.4-mini"
PLANNER_MAX_STEPS="15"
PLANNER_HISTORY_LIMIT="5"
PLANNER_ASK_USER_CAP="2"

# Cloudflare R2 Storage Configuration
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# --- Red-team LLM provider (judge + attackers) ---
# anthropic (default, current behaviour) | azure
REDTEAM_MODEL_PROVIDER="anthropic"
# Per-role overrides. Azure ships one chat deployment, so both roles land on it
# unless a second is configured — the judge detects that and skips escalation.
REDTEAM_FAST_MODEL=""
REDTEAM_STRONG_MODEL=""
# Cross-provider fallback on failure. "off" fails loudly on one vendor instead.
REDTEAM_LLM_FALLBACK="on"
