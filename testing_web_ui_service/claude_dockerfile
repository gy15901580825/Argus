# Claude Code Development Environment
# Build:  docker build -f claude_dockerfile -t claude-dev-env .
# Run:
#   docker run -it \
#     -e DISPLAY=$DISPLAY \
#     -v /tmp/.X11-unix:/tmp/.X11-unix \
#     --shm-size=2g \
#     --env-file .env \
#     -v $(pwd):/app \
#     claude-dev-env

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies: Python, Chromium, X11 libs, build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    chromium-browser \
    fonts-liberation \
    fonts-noto-color-emoji \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxrender1 \
    libxtst6 \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libexpat1 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2t64 \
    libatspi2.0-0 \
    dbus \
    xdg-utils \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Node.js 24.x
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

# Copy and install browser_use local dependency first (changes less often)
COPY browser_use/ /app/browser_use/
RUN pip install --break-system-packages -e /app/browser_use/

# Install project Python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --break-system-packages -r requirements.txt

# Use system Chromium for Playwright (Playwright lacks Ubuntu 26.04 builds)
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Copy dev-browser skill and install its dependencies
RUN mkdir -p /root/.claude/skills/dev-browser
COPY skills/dev-browser/ /root/.claude/skills/dev-browser/
RUN cd /root/.claude/skills/dev-browser && npm install

# Copy the rest of the application
COPY server.py /app/server.py
COPY run.sh /app/run.sh

# Environment: run Chromium without sandbox inside container
ENV CHROME_NO_SANDBOX=1
ENV CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-dev-shm-usage"

# Default command
CMD ["bash"]
